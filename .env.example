# Base URL of the Ktor service in sansoftama/kula-party-backend.
# No path suffix. This app calls /v1/admin/... on that origin.
# Read on the server at request time. Default if unset: http://localhost:8080
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080

# Server-only bearer token. Sent as Authorization: Bearer <token>.
# Never commit a real token. This value is not exposed to the browser.
ADMIN_API_TOKEN=

# true serves typed fixtures and does not call Ktor.
# Any other value, including unset, calls the backend.
USE_MOCK_ADMIN_API=true
