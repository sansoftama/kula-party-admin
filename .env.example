# Base URL of the Ktor service in sansoftama/kula-party-backend.
# No path suffix. This app calls /v1/admin/... on that origin.
# Read on the server at request time. Default if unset: http://localhost:8080
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080

# Server-only bearer token. Sent as Authorization: Bearer <token>.
# Never commit a real token or a filled-in .env.local. Not exposed to the browser.
# dev-admin-token is the documented non-prod stub only (backend ADMIN_API_TOKEN).
ADMIN_API_TOKEN=dev-admin-token

# false calls the live local Ktor stubs (GET /v1/admin/health and /v1/admin/users).
# true serves typed fixtures and does not call Ktor (UI-only work without the backend).
USE_MOCK_ADMIN_API=false
